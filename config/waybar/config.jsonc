{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 4,
  "reload_style_on_change": true,

  "modules-left": [
    "group/launch",
    "group/wallpapers",
    "group/quick-actions"
  ],

  "modules-center": [
    "group/music"
  ],

  "modules-right": [
    "group/datetime",
  ],

"group/launch": {
  "orientation": "horizontal",
  "modules": [
    "custom/launcher",
  ]
},

"group/wallpapers": {
"orientation": "horizontal",
    "modules": [
        "hyprland/workspaces",
    ]
},

"group/quick-actions": {
    "orientation": "horizontal",
    "modules": [
        "custom/wallpaper"
    ]
},
"group/weather": {
    "orientation": "horizontal",
    "modules": [
        "custom/weather"
    ]
},

"group/music": {
  "orientation": "horizontal",
  "modules": [
    "image#album-art",
    "mpris"
  ]
},


"group/datetime": {
    "orientation": "horizontal",
    "modules": [
        "pulseaudio",
        "clock",
        "custom/power"
    ]
},

  // Left modules
  "custom/launcher": {
    "format": "󰣇",
    "tooltip-format": "Application launcher",
    "on-click": "rofi -show drun -modi drun "
  },

  "custom/wallpaper": {
    "exec": "ls ~/dotfiles/config/hypr/wallpapers | wc -l",
    "format": "󰸉",
    "tooltip-format": "Pick from {} wallpapers!",
    "on-click": "~/.config/waybar/scripts/wallpaper-selector.sh"
  },

  // Center modules
  "mpris": {
    "format": "{title}",
    "format-paused": "{title}",
    "player-icons": {
      "default": "",
      "mpv": ""
    },
    "status-icons": {
      "paused": ""
    },
    "interval": 1
  },

  "image#album-art": {
    "exec": "~/.config/waybar/scripts/mpris-art.sh",
    "interval": 5,
    "size": 28,
    "tooltip": true
  },


"hyprland/workspaces": {
  "format": "{id}",
  "on-click": "activate",
  "on-scroll-up": "~/.config/waybar/scripts/workspace-scroll.sh up",
  "on-scroll-down": "~/.config/waybar/scripts/workspace-scroll.sh down",
  "all-outputs": false,

  "persistent-workspaces": {
    "*": [1, 2, 3, 4, 5]
  }
},


  "custom/notification": {
    "tooltip-format": "Notifications: {}",
    "format": "{} {icon}",
    "format-icons": {
      "notification": "󰂚",
      "none": "󰂜",
      "dnd-notification": "󰂛",
      "dnd-none": "󰪑",
      "inhibited-notification": "󰂚",
      "inhibited-none": "󰂜",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰪑"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "sleep 0.1 && swaync-client -t -sw",
    "on-click-right": "sleep 0.1 && swaync-client -d -sw",
    "escape": true
  },

  "clock": {
    "format": "{:%d %b %y - %I:%M %p}",
    "rotate": 0,
	"format-alt": "{:%d %b %y - %I:%M %p}",
  },

  "custom/weather": {
    "exec": "~/.config/waybar/scripts/weather.sh",
    "return-type": "json",
    "interval": 120,
    "format": "{}",
    "on-click": "~/.config/waybar/scripts/weather.sh toggle",
    "signal": 8
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 Muted",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "hyprctl dispatch exec pwvucontrol",
    "tooltip-format": "Current volume: {volume}%"
  },

  "custom/quick-actions": {
    "format": "",
    "tooltip-format": "Quick Actions",
    "on-click": "~/.config/waybar/scripts/quick-actions.sh"
  },

  "custom/power": {
    "exec": "~/.config/waybar/scripts/battery-status.sh",
    "return-type": "json",
    "interval": 10,
    "on-click": "wlogout --buttons-per-row 3"
  }
}
