{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 4,
    "reload_style_on_change": true,

    "modules-left": [
        "custom/launcher",
        "hyprland/workspaces",
        "custom/wallpaper"
    ],

    "modules-center": [
        "mpris"
    ],

    "modules-right": [
        "custom/weather",
        "pulseaudio",
        "clock",
        "custom/power"
    ],

    // Left modules
    "custom/launcher": {
        "format": "󰣇",
        "tooltip-format": "Application launcher",
        "on-click": "rofi -show drun -modi drun -theme ~/.config/rofi/grid.rasi"
    },

    "custom/wallpaper": {
        "exec": "ls ~/dotfiles/config/hypr/wallpapers | wc -l",
        "format": "󰸉",
        "tooltip-format": "Pick from {} wallpapers!",
        "on-click": "~/.config/waybar/scripts/wallpaper-selector.sh"
    },

    "cpu": {
        "format": "󰻠 {usage}%",
        "interval": 2,
        "on-click": "kitty --class floating --title floating -e sh -c 'while true; do btop; sleep 0.1; done' &"
    },

    "memory": {
        "format": "󰍛 {percentage}%",
        "tooltip-format": "Used {used:0.1f}G / Total {total:0.1f}G used",
        "interval": 2,
        "on-click": "kitty --class floating --title floating -e sh -c 'while true; do btop; sleep 0.1; done' &"
    },

    "network": {
        "format": "󰇚 {bandwidthDownBits} 󰕒 {bandwidthUpBits}",
        "format-disconnected": "󰛳 Disconnected",
        "tooltip-format": "Down: {bandwidthDownBits} Up: {bandwidthUpBits}",
        "interval": 2,
        "on-click": "kitty --class floating --title floating -e sh -c 'while true; do btop; sleep 0.1; done' &"
    },

    "custom/gpu": {
        "exec": "~/.config/waybar/scripts/gpu.sh",
        "format": "󰢮 {}",
        "return-type": "json",
        "interval": 2,
        "on-click": "kitty --class floating --title floating -e nvitop"
    },

    "disk": {
        "format": "󰋊 {percentage_used}%",
        "path": "/",
        "tooltip-format": "{used} / {total} used ({percentage_used}%)",
        "interval": 30,
        "on-click": "kitty --class floating --title floating -e watch duf"
    },

    // Center modules
    "mpris": {
        "format": "{player_icon}",
        "format-paused": "{status_icon}",
        "format-[status]": "{title}",
        "player-icons": {
            "default": "",
            "mpv": ""
        },
        "status-icons": {
            "paused": ""
        },
        "interval":1
    },
    
    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "on-scroll-up": "~/.config/waybar/scripts/workspace-scroll.sh up",
        "on-scroll-down": "~/.config/waybar/scripts/workspace-scroll.sh down",
        "all-outputs": false
    },

    "custom/notification": {
        "tooltip-format": "Notifications: {}",
        "format": "{} {icon}",
        "format-icons": {
            "notification": "󰂚",
            "none": "󰂜",
            "dnd-notification": "󰂛",
            "dnd-none": "󰪑",
            "inhibited-notification": "󰂚",
            "inhibited-none": "󰂜",
            "dnd-inhibited-notification": "󰂛",
            "dnd-inhibited-none": "󰪑"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "sleep 0.1 && swaync-client -t -sw",
        "on-click-right": "sleep 0.1 && swaync-client -d -sw",
        "escape": true
    },

    // Right modules
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "on-scroll": 1,
            "on-click-right": "mode",
            "format": {
                "months": "<span color='#ffead3'><b>{}</b></span>",
                "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
                "today": "<span color='#ff6699'><b>{}</b></span>"
            }
        },
    "clock": {
        "format": "{:%I:%M %p}",
        "rotate": 0,
        "format-alt": "{:%R  󰃭 %m|%d|%y}",
        "tooltip-format": "<span>{calendar}</span>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "on-scroll": 1,
            "on-click-right": "mode",
            "format": {
                "months": "<span color='#ffead3'><b>{}</b></span>",
                "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
                "today": "<span color='#ff6699'><b>{}</b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-click-forward": "tz_up",
            "on-click-backward": "tz_down",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    "custom/weather": {
        "exec": "~/.config/waybar/scripts/weather.sh",
        "return-type": "json",
        "interval": 120,
        "format": "{}",
        "on-click": "~/.config/waybar/scripts/weather.sh toggle",
        "signal": 8
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 Muted",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "hyprctl dispatch exec pwvucontrol",
        "tooltip-format": "Current volume: {volume}%"
    },

    "custom/quick-actions": {
        "format": "",
        "tooltip-format": "Quick Actions",
        "on-click": "~/.config/waybar/scripts/quick-actions.sh"
    },

    "custom/power": {
        "exec": "~/.config/waybar/scripts/battery-status.sh",
        "return-type": "json",
        "interval": 10,
        "on-click": "wlogout --buttons-per-row 3"
    }
}
